PORT=3000
NODE_ENV=production

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/preservice_backend?retryWrites=true&w=majority
MONGO_FAIL_FAST_ON_DISCONNECT=true
MONGO_RETRY_ATTEMPTS=6
MONGO_RETRY_DELAY_MS=3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=20m
REFRESH_JWT_SECRET=replace-with-a-different-long-random-secret
REFRESH_JWT_EXPIRES_IN=30d

COOKIE_SECURE=true
COOKIE_DOMAIN=
ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.7

FRONTEND_BASE_URL=https://dashboard.example.com
BACKEND_PUBLIC_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
WS_CORS_ORIGINS=https://dashboard.example.com

TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-long-random-secret
TWO_FACTOR_ISSUER=PrestService
TWO_FACTOR_CHALLENGE_EXPIRES_IN=5m
PASSWORD_RESET_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_EXPIRES_IN=15m

MAIL_ENABLED=true
MAIL_FROM="PrestService <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>

CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<r2-bucket>
CLOUDFLARE_R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<public-bucket>.r2.dev
R2_TOKEN_VALUE=<optional-r2-token>

STREAM_ACCOUNT_ID=<cloudflare-stream-account-id>
STREAM_API_TOKEN=<cloudflare-stream-api-token>

CRON_SECRET=replace-with-a-long-random-secret
